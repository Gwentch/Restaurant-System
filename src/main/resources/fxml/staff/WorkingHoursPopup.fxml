<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../style/style.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="cafe94.system.controller.staff.WorkingHoursPopupController">
    <VBox prefHeight="600" prefWidth="500" spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
        <Label styleClass="section-title" text="Edit Working Hours" />

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <VBox fx:id="formContainer" spacing="10">
                <!-- Dynamic rows for Day 1 to Day 5 will be added in controller -->
            </VBox>
        </ScrollPane>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button onAction="#handleCancel" text="Cancel" />
            <Button onAction="#handleSave" text="Save" />
        </HBox>
    </VBox>
</AnchorPane>
