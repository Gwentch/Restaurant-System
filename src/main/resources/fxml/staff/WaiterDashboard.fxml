<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="800" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cafe94.system.controller.staff.WaiterDashboardController">

    <top>
        <HBox alignment="CENTER">
            <Label styleClass="page-title" text="Welcome to Waiter Dashboard">
                <HBox.margin>
                    <Insets bottom="10.0" />
                </HBox.margin></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="loggedInAsLabel" styleClass="login-font" text="Welcome" />
        </HBox>

    </top>




    <center>
        <TabPane>
            <Tab closable="false" styleClass="com-font" text="Outstanding Orders">
                <VBox spacing="10">
                    <HBox />


                    <HBox alignment="CENTER_RIGHT" spacing="10">

                        <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="reminderLabel" style="-fx-font-size: 11px; -fx-text-fill: gray;" text="Only delivery orders waiting for approval.">
                        </Label></HBox>
                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="Show as :">
                            <HBox.margin>
                                <Insets top="10.0" />
                            </HBox.margin></Label>
                        <ComboBox fx:id="filterComboBox" prefWidth="170">
                            <HBox.margin>
                                <Insets top="10.0" />
                            </HBox.margin></ComboBox>
                    </HBox>

                    <TableView fx:id="ordersTable" prefHeight="248.0" prefWidth="760.0">
                        <columns>
                            <TableColumn fx:id="orderIdCol" prefWidth="100" text="Order ID" />
                            <TableColumn fx:id="customerIdCol" prefWidth="150.0" text="Customer ID" />
                            <TableColumn fx:id="orderTypeCol" prefWidth="300" text="Type" />
                            <TableColumn fx:id="statusCol" prefWidth="150" text="Status" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <VBox.margin>
                            <Insets top="10.0" />
                        </VBox.margin>
                    </TableView>

                    <HBox alignment="CENTER">
                        <Button fx:id="approveButton" text="Approved" />
                    </HBox>

                    <Label styleClass="forms-label" text=" 🔍 Details in selected order :" />
                    <HBox alignment="TOP_RIGHT" spacing="5">
                        <TableView fx:id="itemsTable" prefHeight="250" HBox.hgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="itemNameCol" prefWidth="150" text="Item" />
                                <TableColumn fx:id="qtyCol" prefWidth="75" text="Qty" />
                                <TableColumn fx:id="priceCol" prefWidth="75" text="Price (£)" />
                                <TableColumn fx:id="subtotalCol" prefWidth="75" text="Subtotal (£)" />
                            </columns>
                            <HBox.margin>
                                <Insets right="400.0" />
                            </HBox.margin>
                        </TableView>

                    </HBox>
                    <HBox alignment="TOP_RIGHT" spacing="5">
                        <Label fx:id="orderTotalLabel" styleClass="forms-label" text="Total: £0.00">
                            <HBox.margin>
                                <Insets right="420.0" />
                            </HBox.margin></Label>
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <Button onAction="#handleLogout" text="Logout" />
        </HBox>
    </bottom>
</BorderPane>
