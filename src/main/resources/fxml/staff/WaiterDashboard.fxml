<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="800" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cafe94.system.controller.staff.WaiterDashboardController">

    <top>
        <HBox alignment="CENTER">
            <Label styleClass="page-title" text="Welcome to Waiter Dashboard">
                <HBox.margin>
                    <Insets bottom="10.0" />
                </HBox.margin></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="loggedInAsLabel" styleClass="login-font" text="Welcome" />
        </HBox>

    </top>




    <center>
        <TabPane>
            <Tab closable="false" styleClass="com-font" text="Place Order">
                <VBox spacing="15">
            <!-- Customer Info -->
            <HBox alignment="BASELINE_LEFT" spacing="20">
                <Label text="Customer ID: ">
                     <HBox.margin>
                        <Insets top="10.0" />
                     </HBox.margin></Label>
                <ComboBox fx:id="customerComboBox" prefWidth="150" />

                <Label text="Order Type:" />
                <ChoiceBox fx:id="orderType" prefWidth="100" />
            </HBox>

            <!-- Menu and Specials -->
            <HBox alignment="CENTER" spacing="30">

                <!-- Daily Specials -->
                <VBox alignment="TOP_CENTER" spacing="5">
                    <Label styleClass="section-title" text="Daily Specials" />
                    <TableView fx:id="specialsTable" prefHeight="400" prefWidth="250">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="specialNameColumn" prefWidth="160" text="Item Name" />
                            <TableColumn fx:id="specialPriceColumn" prefWidth="89" text="Price" />
                        </columns>
                    </TableView>

                    <HBox alignment="BASELINE_RIGHT" spacing="7">
                        <Label text="Quantity:" />
                        <Spinner fx:id="specialQuantitySpinner" maxWidth="60">
                            <HBox.margin>
                                <Insets top="5.0" />
                            </HBox.margin></Spinner>
                        <Button onAction="#handleAddSpecial" text="Add" />
                    </HBox>
                </VBox>

                <!-- Menu -->
                <VBox alignment="TOP_CENTER" spacing="5">
                    <Label styleClass="section-title" text="Menu" />
                    <TableView fx:id="menuTable" prefHeight="400" prefWidth="250">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="menuNameColumn" prefWidth="160" text="Item Name" />
                            <TableColumn fx:id="menuPriceColumn" prefWidth="89" text="Price" />
                        </columns>
                    </TableView>

                    <HBox alignment="BASELINE_RIGHT" spacing="7">
                        <Label text="Quantity:" />
                        <Spinner fx:id="menuQuantitySpinner" maxWidth="60">
                            <HBox.margin>
                                <Insets top="5.0" />
                            </HBox.margin></Spinner>
                        <Button onAction="#handleAddMenu" text="Add" />
                    </HBox>
                </VBox>

                <!-- Basket -->
                <VBox alignment="TOP_CENTER" spacing="5">
                    <Label styleClass="section-title" text="Your Basket" />
                    <TableView fx:id="basketTable" prefHeight="400" prefWidth="250">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="basketNameColumn" prefWidth="90" text="Item" />
                            <TableColumn fx:id="basketQuantityColumn" prefWidth="30" text="Qty" />
                            <TableColumn fx:id="basketPriceColumn" prefWidth="60" text="U/P" />
                            <TableColumn fx:id="basketSubtotalColumn" prefWidth="70" text="Subtotal" />
                        </columns>
                    </TableView>

                    <Button onAction="#handleRemoveSelected" text="Remove Selected">
                        <VBox.margin>
                            <Insets top="5.0" />
                        </VBox.margin></Button>
                </VBox>

            </HBox>

            <!-- Total -->
            <HBox alignment="TOP_RIGHT" spacing="5">
                <Label fx:id="eatInOrderTotalLabel" styleClass="forms-label" text="Total: £0.00">
                    <HBox.margin>
                        <Insets right="30.0" />
                    </HBox.margin></Label>
            </HBox>

            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="20">
                <Button defaultButton="true" onAction="#handleConfirmOrder" text="Confirm Order">
                    <HBox.margin>
                        <Insets />
                    </HBox.margin></Button>
                <VBox.margin>
                    <Insets bottom="5.0" />
                </VBox.margin>
            </HBox>
                </VBox>
            </Tab>

            <Tab closable="false" styleClass="com-font" text="Outstanding Orders">
                <VBox spacing="10">
                    <HBox />


                    <HBox alignment="CENTER_RIGHT" spacing="10">

                        <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="reminderLabel" style="-fx-font-size: 11px; -fx-text-fill: gray;" text="Only delivery orders waiting for approval.">
                        </Label></HBox>
                        <Region HBox.hgrow="ALWAYS" />

                        <Label text="Show as :">
                            <HBox.margin>
                                <Insets top="10.0" />
                            </HBox.margin></Label>
                        <ComboBox fx:id="filterComboBox" prefWidth="170">
                            <HBox.margin>
                                <Insets top="10.0" />
                            </HBox.margin></ComboBox>
                    </HBox>

                    <TableView fx:id="ordersTable" prefHeight="248.0" prefWidth="760.0">
                        <columns>
                            <TableColumn fx:id="orderIdCol" prefWidth="100" text="Order ID" />
                            <TableColumn fx:id="customerIdCol" prefWidth="150.0" text="Customer ID" />
                            <TableColumn fx:id="orderTypeCol" prefWidth="300" text="Type" />
                            <TableColumn fx:id="orderStatusCol" prefWidth="150" text="Status" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <VBox.margin>
                            <Insets top="10.0" />
                        </VBox.margin>
                    </TableView>

                    <HBox alignment="CENTER">
                        <Button fx:id="approveButton" text="Approve" />
                    </HBox>

                    <Label styleClass="forms-label" text=" 🔍 Details in selected order :" />
                    <HBox alignment="TOP_RIGHT" spacing="5">
                        <TableView fx:id="itemsTable" prefHeight="250" HBox.hgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="itemNameCol" prefWidth="150" text="Item" />
                                <TableColumn fx:id="qtyCol" prefWidth="75" text="Qty" />
                                <TableColumn fx:id="priceCol" prefWidth="75" text="Price (£)" />
                                <TableColumn fx:id="subtotalCol" prefWidth="75" text="Subtotal (£)" />
                            </columns>
                            <HBox.margin>
                                <Insets right="400.0" />
                            </HBox.margin>
                        </TableView>

                    </HBox>
                    <HBox alignment="TOP_RIGHT" spacing="5">
                        <Label fx:id="orderTotalLabel" styleClass="forms-label" text="Total: £0.00">
                            <HBox.margin>
                                <Insets right="420.0" />
                            </HBox.margin></Label>
                    </HBox>
                </VBox>
            </Tab>

            <Tab closable="false" styleClass="com-font" text="Booking Requests">
                <VBox spacing="10">

                    <TableView fx:id="bookingTable" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="idCol" prefWidth="50" text="Booking ID" />
                            <TableColumn fx:id="customerCol" prefWidth="100" text="Customer ID" />
                            <TableColumn fx:id="guestCol" prefWidth="50" text="Guests" />
                            <TableColumn fx:id="dateCol" prefWidth="100" text="Date" />
                            <TableColumn fx:id="timeCol" prefWidth="70" text="Time" />
                            <TableColumn fx:id="durationCol" prefWidth="70" text="Duration" />
                            <TableColumn fx:id="bookingStatusCol" prefWidth="130" text="Status" />
                        </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER" spacing="10">
                        <Button onAction="#handleBookingApprove" text="Approve Booking" />
                    </HBox>

                </VBox>
            </Tab>
        </TabPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <Button onAction="#handleLogout" text="Logout" />
        </HBox>
    </bottom>
</BorderPane>
