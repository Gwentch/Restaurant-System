<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane alignment="CENTER" hgap="2" prefHeight="520.0" prefWidth="600" stylesheets="@../style/style.css" vgap="10" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cafe94.system.controller.staff.StaffDetailsPopupController">

    <!-- Dynamic Title -->
    <Label fx:id="titleLabel" text="Edit Staff Details" styleClass="section-title" GridPane.columnSpan="2" />

    <Label text="First Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <TextField fx:id="firstNameField" promptText="First Name" GridPane.columnIndex="1" GridPane.rowIndex="1" />

    <Label text="Last Name:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
    <TextField fx:id="lastNameField" promptText="Last Name" GridPane.columnIndex="1" GridPane.rowIndex="2" />

    <Label text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
    <ComboBox fx:id="roleComboBox" GridPane.columnIndex="1" GridPane.rowIndex="3" />

    <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
    <PasswordField fx:id="passwordField" promptText="Password" GridPane.columnIndex="1" GridPane.rowIndex="4" />

    <Label text="🔒 Total Planned Hours:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
    <TextField fx:id="hoursToWorkField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="5" />

    <Label text="🔒 Total Worked Hours:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
    <TextField fx:id="totalHoursWorkedField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="6" />

    <Button onAction="#handleEditWorkingHours" text="View/Edit Working Hours" GridPane.columnIndex="1" GridPane.rowIndex="7" />

    <HBox spacing="20" alignment="CENTER" GridPane.columnSpan="5" GridPane.rowIndex="14">
        <Button text="Cancel" onAction="#handleCancel" prefWidth="100" />
        <Button text="Save" onAction="#handleSave" prefWidth="100" />
    </HBox>

   <columnConstraints>
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
   </rowConstraints>

</GridPane>
