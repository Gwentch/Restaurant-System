<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="800" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cafe94.system.controller.staff.ChefDashboardController">

    <top>
        <HBox alignment="CENTER">
            <Label styleClass="page-title" text="Welcome to Chef Dashboard">
                <HBox.margin>
                    <Insets bottom="10.0" />
                </HBox.margin></Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="loggedInAsLabel" styleClass="login-font" text="Welcome" />
        </HBox>
    </top>

    <center>
        <TabPane maxHeight="600.0" prefHeight="600.0" prefWidth="770.0">
            <!-- Outstanding Orders Tab -->
            <Tab closable="false" styleClass="com-font" text="Outstanding Orders">
                <VBox spacing="10">
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label text="Show as :">
                     <HBox.margin>
                        <Insets top="10.0" />
                     </HBox.margin></Label>
                        <ComboBox fx:id="filterComboBox" prefWidth="170">
                     <HBox.margin>
                        <Insets top="10.0" />
                     </HBox.margin></ComboBox>
                    </HBox>

                    <TableView fx:id="ordersTable" prefHeight="200">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="orderIdCol" prefWidth="75" text="Order ID" />
                            <TableColumn fx:id="customerIdCol" prefWidth="75" text="Customer ID" />
                            <TableColumn fx:id="orderTypeCol" prefWidth="100" text="Type" />
                            <TableColumn fx:id="orderStatusCol" prefWidth="150" text="Status" />
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER">
                    <Button fx:id="actionButton" onAction="#handleMarkOrderComplete" prefWidth="80" text="Complete" />
                    </HBox>

                    <Label styleClass="forms-label" text=" 🔍 Details in selected order :" />
                    <HBox alignment="TOP_RIGHT" spacing="5">
                        <TableView fx:id="itemsTable" prefHeight="150" HBox.hgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="itemNameCol" prefWidth="150" text="Item" />
                                <TableColumn fx:id="qtyCol" prefWidth="75" text="Qty" />
                                <TableColumn fx:id="priceCol" prefWidth="75" text="Price (£)" />
                                <TableColumn fx:id="subtotalCol" prefWidth="75" text="Subtotal (£)" />
                            </columns>
                            <HBox.margin>
                                <Insets right="400.0" />
                            </HBox.margin>
                        </TableView>
                    </HBox>

                    <HBox alignment="TOP_RIGHT" spacing="5">
                        <Label fx:id="orderTotalLabel" styleClass="forms-label" text="Total: £0.00">
                            <HBox.margin>
                                <Insets right="420.0" />
                            </HBox.margin></Label>
                    </HBox>
                </VBox>
            </Tab>

            <!-- Tab 2: Daily Specials -->
            <Tab closable="false" text="Daily Specials Menu" styleClass="com-font">
                <VBox spacing="10">
                    <Label alignment="BOTTOM_LEFT" styleClass="forms-label" text="〰〰  Today's Specials  〰〰">
                  <VBox.margin>
                     <Insets top="8.0" />
                  </VBox.margin></Label>
                    <TableView fx:id="specialsTable">
                        <columns>
                            <TableColumn fx:id="specialNameCol" prefWidth="200" text="Name" />
                            <TableColumn fx:id="specialPriceCol" prefWidth="100" text="Price (£)" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <HBox spacing="10">
                        <Label text="From Menu :" />
                        <ComboBox fx:id="menuComboBox" prefWidth="200" />
                        <Button onAction="#handleAddFromMenu" text="Add from Menu" />
                    </HBox>

                    <Label text="Or Create New Special Item :" />
                    <HBox spacing="10">
                        <TextField fx:id="specialNameField" promptText="Item Name" />
                        <TextField fx:id="specialPriceField" maxWidth="-Infinity" prefHeight="25.0" prefWidth="116.0" promptText="Price" />
                        <Button onAction="#handleAddNewSpecial" prefHeight="23.0" prefWidth="107.0" text="Add New Item" />
                    </HBox>
                    <Button onAction="#handleRemoveSpecial" text="Remove Selected Item" />
                </VBox>
            </Tab>
        </TabPane>
    </center>

<bottom>
    <HBox alignment="BOTTOM_RIGHT">
        <Region VBox.vgrow="ALWAYS" />
        <Button alignment="BASELINE_RIGHT" onAction="#handleLogout" text="Logout" />
    </HBox>
</bottom>





</BorderPane>
