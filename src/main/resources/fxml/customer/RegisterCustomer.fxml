<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="800" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cafe94.system.controller.customer.RegisterCustomerController">

    <VBox alignment="TOP_CENTER" layoutX="70.0" layoutY="96.0" prefWidth="300" spacing="20" AnchorPane.leftAnchor="70.0" AnchorPane.rightAnchor="70.79999999999995">

        <VBox alignment="BOTTOM_CENTER" spacing="10">
            <Label text="First Name : " />
            <TextField fx:id="firstNameField" alignment="CENTER" maxWidth="200" promptText="Enter your first name" />

            <Label text="Last Name : " />
            <TextField fx:id="lastNameField" alignment="CENTER" maxWidth="200" promptText="Enter your last name" />

            <Label text="Address : " />
            <TextField fx:id="addressField" alignment="CENTER" maxWidth="200" promptText="Enter your address" />

            <Label text="Password : " />
            <PasswordField fx:id="passwordField" alignment="CENTER" maxWidth="200" promptText="Choose a password" />
        </VBox>

        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="registerButton" onAction="#handleRegister" text="Register" />
            <Button onAction="#handleCancel" text="Cancel" />
        </HBox>

        <Label fx:id="statusLabel" textFill="red" />
    </VBox>
     <Label layoutX="294.0" layoutY="38.0" styleClass="page-title" text="Create New Account">
        </Label>
</AnchorPane>
