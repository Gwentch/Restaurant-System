<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-padding: 20; -fx-spacing: 10" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cafe94.system.controller.customer.OrderDetailsPopupController">

    <top>
        <!-- Title -->
        <Label fx:id="orderIdLabel" text="Order ID: (auto)" styleClass="section-title"/>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets left="5" right="5" top="20" />
            </padding>
            <!-- Order Summary -->
            <TableView fx:id="orderTable" prefHeight="500" prefWidth="250">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="itemNameColumn" prefWidth="180" text="Item" />
                    <TableColumn fx:id="itemQtyColumn" prefWidth="50" text="Qty" />
                    <TableColumn fx:id="itemPriceColumn" prefWidth="90" text="Price" />
                    <TableColumn fx:id="itemSubtotalColumn" prefWidth="90" text="Subtotal" />
                </columns>
            </TableView>

            <!-- Total -->
            <HBox alignment="CENTER_RIGHT" spacing="5">
                <Label fx:id="orderTotalLabel" styleClass="forms-label" text="Total: £0.00">
                    <HBox.margin>
                        <Insets right="30.0" />
                    </HBox.margin>
                </Label>
            </HBox>

            <!-- Takeaway Section -->
            <VBox fx:id="takeawayPane" spacing="5" visible="false">
                <Label text="Pickup Time:" />
                <ComboBox fx:id="pickupTimeCombo" prefWidth="200" />
            </VBox>

            <!-- Delivery Section -->
            <VBox fx:id="deliveryPane" spacing="5" visible="false">
                <Label text="Delivery Address:" />
                <TextField fx:id="deliveryAddress" prefWidth="300" />
                <CheckBox fx:id="useProfileAddressCheckBox" onAction="#handleUseProfileAddress" text="Use saved address" />
                <Label text="Estimated Delivery Time (~ 45 minutes):" />
                <ComboBox fx:id="estimatedDeliveryTimeCombo" prefWidth="200" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />

        </VBox>
    </center>

   <bottom>
         <Button defaultButton="true" onAction="#handleConfirm" text="Confirm" BorderPane.alignment="BOTTOM_RIGHT" />
   </bottom>

</BorderPane>
